{
  "manifest_version": 3,
  "name": "TechRecon",
  "short_name": "TechRecon",
  "description": "Passive technology fingerprinting and CVE intelligence for ethical pentesters.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "TechRecon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["https://services.nvd.nist.gov/*", "https://api.osv.dev/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open TechRecon for the current tab"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
