{
  "name": "techrecon",
  "version": "1.0.0",
  "description": "TechRecon — browser technology fingerprinting & CVE intelligence (Chrome MV3)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "cross-env TECHRECON_E2E=1 npm run build && playwright test",
    "icons": "node scripts/gen-icons.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "license": "MIT"
}
